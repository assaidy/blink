@baseUrl = http://localhost:8000

################################################################################
# AUTH ROUTES - Registration Flow
################################################################################

### Register - Success
POST {{baseUrl}}/auth/register

{
  "name": "John Doe 2",
  "username": "johndoe2",
  "email": "john2@example.com",
  "bio": "Hello, I am John 2!"
}

### Register - Username Conflict
POST {{baseUrl}}/auth/register

{
  "name": "John Doe",
  "username": "johndoe",
  "email": "john2@example.com"
}

### Register - Email Conflict
POST {{baseUrl}}janedoe/auth/register

{
  "name": "Jane Doe",
  "username": "janedoe",
  "email": "john@example.com"
}

### Register - Invalid Username
POST {{baseUrl}}/auth/register

{
  "name": "John Doe",
  "username": "john@doe",
  "email": "john@example.com"
}

### Register - Invalid Email
POST {{baseUrl}}/auth/register

{
  "name": "John Doe",
  "username": "johndoe2",
  "email": "not-an-email"
}

### Register - Missing Fields
POST {{baseUrl}}/auth/register

{
  "name": "John Doe"
}

################################################################################
# OTP Routes
################################################################################

### Request OTP - Success
POST {{baseUrl}}/auth/otp/request

{
  "channel": "email",
  "identifier": "john@example.com",
  "purpose": "login",
}

### otpID: 01KFAQS2S7TTCNXP8K2MN3KXVZ

### Request OTP - Email Not Found
POST {{baseUrl}}/auth/otp/request

{
  "channel": "email",
  "identifier": "nonexistent@example.com",
  "purpose": "login",
}

### Request OTP - Invalid Purpose
POST {{baseUrl}}/auth/otp/request

{
  "channel": "email",
  "identifier": "john@example.com",
  "purpose": "invalid",
}

### Verify OTP - Success
POST {{baseUrl}}/auth/otp/verify

{
  "otpID": "01KFAQS2S7TTCNXP8K2MN3KXVZ",
  "otp": "392618"
}

### csrf_token=01KFAQTAKJKJR6RM92E0ZKYR5J_fd7643c99bb1920ec925d8e5d5fb0d86e3251889e183013da9516741277102a8

### Verify OTP - Invalid OTP
POST {{baseUrl}}/auth/otp/verify

{
  "otpID": "01HABC123XYZ",
  "otp": "000000"
}

################################################################################
# AUTH ROUTES - Session Management (Require Authentication)
################################################################################

### Get Active Sessions - No Session (Unauthorized)
GET {{baseUrl}}/auth/sessions

### Get Active Sessions - With Session
